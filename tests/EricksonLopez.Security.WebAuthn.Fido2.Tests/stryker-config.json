{
  "stryker-config": {
    "project": "EricksonLopez.Security.WebAuthn.Fido2.csproj",
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "concurrency": 2,
    "mutate": [
      "**/*.cs",
      "!**/bin/**",
      "!**/obj/**"
