{
  "stryker-config": {
    "project": "EricksonLopez.Security.Network.csproj",
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "target-framework": "net10.0",
    "coverage-analysis": "all",
    "ignore-methods": [
      "*SetTag*",
      "*SetStatus*",
      "*Record*",
      "*Counter*.Add*",
      "*ArrayPool*",
      "*Rent*",
      "*Return*",
      "ConfigureAwait"
    ],
    "ignore-mutations": [],
    "reporters": [
      "Progress",
      "ClearText",
      "Html",
      "Json"
    ],
    "concurrency": 2
  }
}
