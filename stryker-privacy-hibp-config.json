{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/StrykerConfig.schema.json",
  "stryker-config": {
    "project": "src/EricksonLopez.Security.Privacy.Hibp/EricksonLopez.Security.Privacy.Hibp.csproj",
    "test-projects": [
      "tests/EricksonLopez.Security.Privacy.Hibp.Tests/EricksonLopez.Security.Privacy.Hibp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "concurrency": 2,
    "mutate": [
      "**/*.cs",
      "!bin/**",
      "!obj/**",
      "!**/*.g.cs"
    ],
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "ignore-methods": [
      "ConfigureAwait",
      "*Log*",
      "*ZeroMemory*",
      "*ArrayPool*",
      "*Rent*",
      "*Return*"
    ],
    "ignore-mutations": [],
    "reporters": [
      "Progress",
      "ClearText",
      "Html",
      "Json"
    ]
  }
}
