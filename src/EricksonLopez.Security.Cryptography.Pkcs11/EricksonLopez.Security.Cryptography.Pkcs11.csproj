<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.Security.Cryptography.Pkcs11</AssemblyName>
    <RootNamespace>EricksonLopez.Security.Cryptography.Pkcs11</RootNamespace>
    <PackageId>EricksonLopez.Security.Cryptography.Pkcs11</PackageId>
    <Description>Native AOT compatible PKCS#11 integration for EricksonLopez.Security ecosystem, providing hardware security module (HSM) bridging via direct unmanaged P/Invoke bindings.</Description>
    <PackageTags>$(CommonPackageTags);cryptography;pkcs11;hsm;hardware-security;smartcard;digital-signature;native-aot</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Security.Abstractions\EricksonLopez.Security.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Security.Cryptography.Pkcs11.Tests" />
    <InternalsVisibleTo Include="EricksonLopez.Security.Sample" />
  </ItemGroup>

</Project>


