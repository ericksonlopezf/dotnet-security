<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>FIDO Alliance Metadata Service v3 (MDS3) integration satellite for EricksonLopez.Security.WebAuthn.Fido2. Provides authenticator manufacturer validation, AAGUID lookup, and attestation certificate chain verification against the FIDO Alliance trust anchor.</Description>
    <PackageTags>$(CommonPackageTags);webauthn;fido2;mds3;fido-mds;aaguid;attestation;authenticator-metadata;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Security.WebAuthn.Fido2\EricksonLopez.Security.WebAuthn.Fido2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Security.WebAuthn.Fido2.Mds3.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
