<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.Security.Cryptography.XmlDSig</AssemblyName>
    <RootNamespace>EricksonLopez.Security.Cryptography.XmlDSig</RootNamespace>
    <PackageId>EricksonLopez.Security.Cryptography.XmlDSig</PackageId>
    <Description>Canonical W3C XML Digital Signature (XMLDSig) and X.509 certificate verification engine for .NET. Supports enveloped signatures, RSA-SHA256, C14N canonicalization, and fiscal compliance standards (e-CF / DGII).</Description>
    <PackageTags>$(CommonPackageTags);xmldsig;xml-signature;digital-signature;c14n;enveloped-signature;x509;rsa-sha256;e-cf;fiscal</PackageTags>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="EricksonLopez.Result" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Security.Cryptography.XmlDSig.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
