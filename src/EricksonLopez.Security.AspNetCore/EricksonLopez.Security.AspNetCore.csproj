<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.Security.AspNetCore</AssemblyName>
    <RootNamespace>EricksonLopez.Security.AspNetCore</RootNamespace>
    <PackageId>EricksonLopez.Security.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for EricksonLopez.Security providing security headers, API key middleware, token extractors, and request security context.</Description>
    <PackageTags>$(CommonPackageTags);aspnetcore;authentication;middleware;security-headers;api-key;csp;hsts;native-aot</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Security\EricksonLopez.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
