    <PackageTags>$(CommonPackageTags);azure;keyvault;key-vault;key-management;secrets-management;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Security.Abstractions\EricksonLopez.Security.Abstractions.csproj" />
