<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.Security.OpenTelemetry</AssemblyName>
    <RootNamespace>EricksonLopez.Security.OpenTelemetry</RootNamespace>
    <PackageId>EricksonLopez.Security.OpenTelemetry</PackageId>
    <Description>Optional OpenTelemetry instrumentation satellite for EricksonLopez.Security. Provides automatic ActivitySource registration, metrics (Meter), and semantic conventions for encrypt/decrypt, password hashing, key lifecycle, and API key validation operations.</Description>
    <PackageTags>$(CommonPackageTags);opentelemetry;otel;tracing;metrics;observability;diagnostics</PackageTags>
    <!-- This satellite has OTel SDK dependency — intentionally NOT in core per ADR-019 -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Security\EricksonLopez.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

</Project>
